# ==========================================================================
# Configuracion de la aplicacion de turnos del consultorio
# Copie este archivo a ".env" y complete los valores reales.
# ==========================================================================

# --- Servidor ---
PORT=3000
# URL publica de la app (usada para armar links enviados por WhatsApp)
APP_BASE_URL=http://localhost:3000
# Zona horaria usada por los jobs programados
TZ=America/Argentina/Buenos_Aires

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=consultorio

# --- Reporte diario de turnos ---
# Hora (cron) a la que se genera y envia el reporte del dia siguiente.
# Formato cron estandar (min hora * * *). Por defecto: 20:00 todos los dias.
DAILY_REPORT_CRON=0 20 * * *
# Canales de envio del reporte: email, whatsapp o "email,whatsapp"
DAILY_REPORT_CHANNELS=email,whatsapp

# --- WhatsApp ---
# Proveedor: "twilio", "cloud" (WhatsApp Cloud API de Meta) o "log" (solo consola, para pruebas)
WHATSAPP_PROVIDER=cloud

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero de WhatsApp de Twilio en formato: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_TOKEN=EAAfmKKpfyFQBSFs2sET0zWXFLIfdC6UZCyLFJtnqHlgyuheHc01A1VaVT7oZCf8WQMjkqZBNKNzyXvtcWP2YZAFBtbaPkCoG9GZAcNZA6RGtsDmoYqGi22rlYMkNNZAgLpso7DSuLQM1eb9mgyUGYzZBCxP5RwT8hYBty44pO3ZBfVhZCo1SKh0URGR7Vf8xVqsXKTqzYNAuzG7fr5ZCKIAHObur5772cpKNrQbQzDIzETHssDMxVGTPEC7VsMXqYMkPTtqm1ZArVqpZAPsqRp9fybGxsDBAZD
WHATSAPP_CLOUD_PHONE_ID=1234170406448138
# Token para verificar el webhook (lo define usted en la consola de Meta)
WHATSAPP_CLOUD_VERIFY_TOKEN=mi-token-de-verificacion
WHATSAPP_TEMPLATE_NAME=consultorio_notificacion
WHATSAPP_TEMPLATE_LANG=es_AR

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Consultorio Medico <no-reply@consultorio.com>"
