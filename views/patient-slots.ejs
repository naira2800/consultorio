<%- include('partials/head', { title: 'Elegir horario' }) %>

<div class="card">
  <h1>Elija su horario</h1>
  <p class="muted">
    Profesional: <strong><%= request.professional_name %></strong>
    <%= request.specialty ? '- ' + request.specialty : '' %>
  </p>

  <% if (error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <% if (slots.length === 0) { %>
    <div class="alert warning">
      Por el momento no hay horarios disponibles. El profesional cargará nuevos
      horarios a la brevedad.
    </div>
  <% } else { %>
    <form action="/turnos/elegir/<%= request.token %>" method="POST">
      <div class="slots">
        <% slots.forEach(function (s) { %>
          <label class="slot">
            <input type="radio" name="slot_id" value="<%= s.id %>" required />
            <span><%= new Date(s.starts_at).toLocaleString('es-AR', {
              weekday: 'short', day: '2-digit', month: '2-digit',
              hour: '2-digit', minute: '2-digit', hour12: false
            }) %></span>
          </label>
        <% }); %>
      </div>
      <button type="submit" class="btn">Confirmar turno</button>
    </form>
  <% } %>
</div>

<%- include('partials/foot') %>
